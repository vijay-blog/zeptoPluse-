{
  "info": {
    "name": "NexaMart Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"identifier\":\"admin\",\"password\":\"admin@223\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Delivery Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Delivery User\",\"email\":\"delivery@example.com\",\"phone\":\"9999999999\",\"password\":\"Password123\",\"confirmPassword\":\"Password123\"}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Catalog Products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/catalog/products?page=0&pageSize=20"
      }
    },
    {
      "name": "Admin Orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/admin/orders?page=0&pageSize=20"
      }
    },
    {
      "name": "Delivery Orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/delivery/orders?page=0&pageSize=20"
      }
    }
  ]
}